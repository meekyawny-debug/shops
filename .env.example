# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/shops?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# CJ Dropshipping
CJ_API_KEY="your-cj-api-key"
CJ_EMAIL="your-cj-email"

# AliExpress
AE_APP_KEY="your-aliexpress-app-key"
AE_APP_SECRET="your-aliexpress-app-secret"
AE_ACCESS_TOKEN="your-aliexpress-access-token"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="shops-images"
R2_PUBLIC_URL="https://images.yourdomain.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
